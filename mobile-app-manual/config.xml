<?xml version='1.0' encoding='utf-8'?>
<widget id="com.medai.diagnostics" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>MedAI Diagnostics</name>
    <description>Advanced Medical Imaging Analysis Platform</description>
    <author email="medai@diagnostics.com">MedAI Team</author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
